{
  "name": "rainflow-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Streaming ASTM E1049 rainflow counting and Palmgren-Miner damage accumulation backend",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
